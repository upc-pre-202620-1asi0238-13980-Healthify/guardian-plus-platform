SITE_ADDRESS=guardian-plus-api.<region>.cloudapp.azure.com
DATABASE_URL=<server-name>.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=guardian_plus
DATABASE_USER=<admin-user>
DATABASE_PASSWORD=<admin-password>

# Vital sign telemetry: broker reachable from this VM over WebSocket (the simulator VM's Mosquitto, port 9001)
HEALTH_MONITORING_MQTT_ENABLED=true
HEALTH_MONITORING_MQTT_BROKER_URL=ws://<broker-host>:9001
