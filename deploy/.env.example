SITE_ADDRESS=guardian-plus-api.<region>.cloudapp.azure.com
DATABASE_URL=<server-name>.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=guardian_plus
DATABASE_USER=<admin-user>
DATABASE_PASSWORD=<admin-password>

# Vital sign telemetry: broker reachable from this VM over WebSocket (the simulator VM's Mosquitto, port 9001)
HEALTH_MONITORING_MQTT_ENABLED=true
HEALTH_MONITORING_MQTT_BROKER_URL=ws://<broker-host>:9001

# Activity and sleep telemetry: same broker
CARE_ROUTINES_WELLNESS_MQTT_ENABLED=true
CARE_ROUTINES_WELLNESS_MQTT_BROKER_URL=ws://<broker-host>:9001

# IAM: Brevo transactional e-mail (sender on the domain authenticated in Brevo)
BREVO_API_KEY=<brevo-v3-api-key>
IAM_EMAIL_SENDER=no-reply@guardianplus.abrdns.com
# IAM: keys that must survive restarts. HMAC: `openssl rand -base64 32`.
# JWT: `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048` (PKCS#8) and its `openssl pkey -pubout`, one line with \n
IAM_SECRETS_HMAC_KEY=<base64-32-bytes>
IAM_JWT_PRIVATE_KEY=<pkcs8-pem-one-line>
IAM_JWT_PUBLIC_KEY=<x509-pem-one-line>
